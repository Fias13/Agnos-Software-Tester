# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Base URL of the AI Dashboard application under test
BASE_URL=https://dev.app.agnoshealth.com/ai_dashboard

# Test account credentials (ask the project owner for the real values)
TEST_USERNAME=your-test-account@example.com
TEST_PASSWORD=your-test-account-password

# Credentials used for negative-path tests (any values that are NOT a real account)
INVALID_USERNAME=not-a-real-user@example.com
INVALID_PASSWORD=WrongPassword123!
